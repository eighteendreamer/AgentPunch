{
  "name": "agentpunch-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/dev-electron.mjs\"",
    "build": "vite build",
    "start": "npm run build && electron electron/main.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.1"
  }
}
