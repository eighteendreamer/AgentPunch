{
  "name": "agentpunch-desktop",
  "version": "1.0.13",
  "private": true,
  "type": "module",
  "description": "AgentPunch 自动签到桌面客户端",
  "author": "AgentPunch",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/dev-electron.mjs\"",
    "build": "vite build",
    "start": "npm run build && electron electron/main.mjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.agentpunch.desktop",
    "productName": "AgentPunch",
    "asar": true,
    "directories": {
      "output": "release-package"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../../src", "to": "agentpunch-runtime/src" },
      { "from": "../../node_modules/patchright", "to": "agentpunch-runtime/node_modules/patchright" },
      { "from": "../../node_modules/patchright-core", "to": "agentpunch-runtime/node_modules/patchright-core" },
      { "from": "../../package.json", "to": "agentpunch-runtime/package.json" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "public/agentpunch-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentPunch",
      "include": "build/installer.nsh"
    }
  }
}
