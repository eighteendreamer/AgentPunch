{
  "name": "agent-router-auto-checkin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily Agent Router check-in through a persistent GitHub OAuth browser session.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "doctor": "node --disable-warning=ExperimentalWarning src/cli.js doctor",
    "setup": "node --disable-warning=ExperimentalWarning src/cli.js setup",
    "run": "node --disable-warning=ExperimentalWarning src/cli.js run",
    "install-task": "node scripts/task.js install",
    "uninstall-task": "node scripts/task.js uninstall",
    "task-status": "node scripts/task.js status",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:start": "npm --prefix apps/desktop run start",
    "desktop:dist": "npm --prefix apps/desktop run dist",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "patchright": "^1.51.1"
  }
}
